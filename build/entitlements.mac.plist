<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Releases are signed with a self-signed certificate, which has no
         Apple Team ID. Under the hardened runtime, library validation only
         admits code from the app's own Team ID or Apple, so without this the
         app refuses to load Electron Framework and the engines' native .node
         addons. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Auto-paste drives Cmd+V through System Events via osascript. The
         hardened runtime requires the app (as the responsible process) to be
         entitled to send Apple Events, or macOS refuses with -1743. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
